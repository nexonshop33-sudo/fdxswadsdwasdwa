local function hasNestPath()
    local ok, result = pcall(function()
        return workspace:FindFirstChild("Environment")
            and workspace.Environment:FindFirstChild("Nest")
    end)

    return ok and result ~= nil
end

local function runScriptForPlaceID(placeId)
    local scriptURL = WORLD_SCRIPTS[placeId]

    if not scriptURL then
        warn("❌ ไม่มีสคริปต์สำหรับ PlaceID:", placeId)
        return
    end

    print("🟣 Loading script for world:", placeId, "→", scriptURL)

    local ok, content = pcall(function()
        return game:HttpGet(scriptURL)
    end)

    if not ok then
        warn("❌ HttpGet ล้มเหลว:", content)
        return
    end

    -- 🧱 ถ้าข้อมูลว่างหรือไม่มีตัวอักษรเลย → ไม่ต้องรัน
    if not content or content == "" or content:match("^%s*$") then
        warn("⚠️ ไฟล์จากลิงก์นี้ว่างเปล่า หรือไม่มีโค้ดให้รัน:", scriptURL)
        return
    end

    local runOk, err = pcall(function()
        loadstring(content)()
    end)

    if runOk then
        print("✅ โหลดและรันสคริปต์สำเร็จ:", placeId)
    else
        warn("❌ Error ตอนรันสคริปต์:", err)
    end
end


