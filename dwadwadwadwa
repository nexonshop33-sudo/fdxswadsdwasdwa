    local function startBossFight()
        print("🔥 เริ่มระบบ Boss Fight แบบอัจฉริยะ...")

        if isKillBossDone() then
            print("🎉 เควส KillBoss เสร็จแล้ว (1/1)! ข้ามบอส")
